# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider Configuration
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Select LLM provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# ── Google Gemini (default) ───────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash   # Optional: override model name

# ── OpenAI (alternative) ─────────────────────────────────────────────────────
# LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here   # Required for MLflow LLM-as-a-Judge evaluation scorers
OPENAI_MODEL=gpt-4o-mini        # Optional: override model name

# ── Anthropic (alternative) ──────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-haiku-latest  # Optional: override model name

# ── MLflow Configuration ──────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///evaluation/mlflow.db
MLFLOW_EXPERIMENT_ID=1
MLFLOW_ENABLE_ASYNC_LOGGING=false
MLFLOW_MODEL_CATALOG_URI=   # Leave empty to disable remote catalog fetches (prevents startup hangs)
# Concurrency controls: limits parallel API calls during evaluation to avoid rate-limit (429) errors.
# Formula: total concurrent calls ≈ MAX_WORKERS × min(MAX_SCORER_WORKERS, num_scorers)
# With 6 scorers: 3 × min(2, 6) = 6 concurrent calls — safe for moderate OpenAI RPM tiers.
# Increase these values if you are on a higher-tier OpenAI plan.
MLFLOW_GENAI_EVAL_MAX_WORKERS=3
MLFLOW_GENAI_EVAL_MAX_SCORER_WORKERS=2
